#: core/templates/core/index.html:14
msgid ""
"ShareFood connects people who have extra food with those who need it. "
"Sharing food, reducing waste, and building community."
msgstr ""
"ShareFood îi conectează pe cei care au mâncare în plus cu cei care au nevoie "
"de ea. Împărțim mâncarea, reducem risipa și construim comunitatea."

#: core/templates/core/index.html:21
msgid "Share your food"
msgstr "Împarte mâncarea ta"

